<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coms.fins.ojt.mapper.FileMapper">

    <insert id="insertFile">
        INSERT INTO files (file_uuid, original_filename)
        VALUES (#{fileUuid}, #{originalFilename})
    </insert>

    <select id="selectFileByUuid" resultType="coms.fins.ojt.domain.FileVO">
        SELECT file_uuid AS fileUuid, original_filename AS originalFilename, created_at AS createdAt
        FROM files
        WHERE file_uuid = #{fileUuid}
    </select>

    <delete id="deleteFileByUuid">
        DELETE FROM files WHERE file_uuid = #{fileUuid}
    </delete>

</mapper>
